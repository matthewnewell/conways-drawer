{
  "name": "@conways/drawer",
  "version": "0.2.2",
  "description": "Shared UI for every app in the Conway's Depot ecosystem: the app header (back link, tabs, user menu) and the Agent | Journal drawer.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./vite-plugin.d.ts",
      "default": "./vite-plugin.js"
    }
  },
  "files": [
    "dist",
    "vite-plugin.js",
    "vite-plugin.d.ts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/*.css dist/"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
